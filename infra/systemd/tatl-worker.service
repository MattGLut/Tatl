[Unit]
Description=Tatl Portal - Solid Queue worker
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/tatl/apps/portal
EnvironmentFile=/opt/tatl/.env.production
ExecStart=/home/deploy/.rbenv/shims/bundle exec rails solid_queue:start
Restart=on-failure
RestartSec=5
SyslogIdentifier=tatl-worker
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
