# Default to LF line endings everywhere on commit.
* text=auto eol=lf

# Binary types
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  text
*.pdf  binary

# Windows-only batch files keep CRLF so they execute correctly.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
