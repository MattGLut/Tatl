<%= form_with model: [:admin, announcement], class: "space-y-6" do |f| %>
  <% if announcement.errors.any? %>
    <div class="rounded-md border border-rose-200 bg-rose-50 p-4 text-sm text-rose-700 dark:border-rose-900 dark:bg-rose-900/20 dark:text-rose-300">
      <p class="font-semibold">Please fix the following:</p>
      <ul class="mt-2 list-disc pl-5">
        <% announcement.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, class: "mb-1 block text-sm font-medium text-[var(--color-text-secondary)]" %>
    <%= f.text_field :title, class: "w-full rounded-md border border-[var(--color-border)] bg-[var(--color-surface-card)] px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40" %>
  </div>

  <div>
    <%= f.label :body, class: "mb-1 block text-sm font-medium text-[var(--color-text-secondary)]" %>
    <%= f.text_area :body, rows: 4, class: "w-full rounded-md border border-[var(--color-border)] bg-[var(--color-surface-card)] px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40" %>
  </div>

  <div>
    <%= f.label :pinned_until, "Pin until", class: "mb-1 block text-sm font-medium text-[var(--color-text-secondary)]" %>
    <%= f.datetime_local_field :pinned_until, class: "w-full rounded-md border border-[var(--color-border)] bg-[var(--color-surface-card)] px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40" %>
  </div>

  <label class="inline-flex items-center gap-2 text-sm text-[var(--color-text-secondary)]">
    <%= f.check_box :active, class: "h-4 w-4 rounded border-[var(--color-border)] text-brand-600 focus:ring-brand-500" %>
    Active (show in portal banner)
  </label>

  <% if announcement.new_record? %>
    <label class="inline-flex items-center gap-2 text-sm text-[var(--color-text-secondary)]">
      <%= check_box_tag "announcement[send_email_notification]", "1", false, class: "h-4 w-4 rounded border-[var(--color-border)] text-brand-600 focus:ring-brand-500" %>
      Email this announcement to users who opted in
    </label>
  <% end %>

  <div class="flex items-center gap-3">
    <%= f.submit class: "rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700" %>
    <%= link_to "Cancel", admin_announcements_path, class: "text-sm text-[var(--color-text-secondary)] hover:text-brand-600 dark:hover:text-brand-400" %>
  </div>
<% end %>
