<% content_for :title, "Announcements - NeIQhbor" %>

<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">Announcements</h1>
  <%= link_to "New announcement", new_admin_announcement_path, class: "rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700" %>
</div>

<% if @announcements.any? %>
  <div class="mt-6 overflow-hidden rounded-lg border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800">
    <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-700">
      <thead class="bg-slate-50 dark:bg-slate-800/80">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Title</th>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Status</th>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Pin until</th>
          <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
        <% @announcements.each do |announcement| %>
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/50">
            <td class="px-4 py-3 text-sm">
              <%= link_to announcement.title, admin_announcement_path(announcement), class: "font-medium text-brand-600 hover:text-brand-800 dark:text-brand-400 dark:hover:text-brand-300" %>
            </td>
            <td class="px-4 py-3 text-sm">
              <% if announcement.active? %>
                <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-400">Active</span>
              <% else %>
                <span class="rounded-full bg-slate-200 px-2 py-0.5 text-xs font-medium text-slate-700 dark:bg-slate-700 dark:text-slate-300">Inactive</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-sm text-slate-500 dark:text-slate-400">
              <%= announcement.pinned_until ? announcement.pinned_until.strftime("%b %d, %Y %l:%M %p") : "Not pinned" %>
            </td>
            <td class="px-4 py-3 text-right text-sm">
              <div class="inline-flex items-center gap-3">
                <%= link_to "Edit", edit_admin_announcement_path(announcement), class: "text-brand-600 hover:text-brand-800 dark:text-brand-400 dark:hover:text-brand-300" %>
                <%= link_to "Delete",
                            admin_announcement_path(announcement),
                            data: { turbo_method: :delete, turbo_confirm: "Delete this announcement?" },
                            class: "text-rose-600 hover:text-rose-700 dark:text-rose-400 dark:hover:text-rose-300" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="mt-8 rounded-xl border border-dashed border-slate-300 p-10 text-center dark:border-slate-600">
    <p class="text-sm text-slate-500 dark:text-slate-400">No announcements yet.</p>
  </div>
<% end %>
