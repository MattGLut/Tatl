<% content_for :title, "Account settings - NeIQhbor" %>

<div class="mx-auto mt-2 max-w-2xl space-y-6">
  <header>
    <h1 class="text-2xl font-bold tracking-tight text-slate-900">Account settings</h1>
    <p class="mt-1 text-sm text-slate-600">Manage your profile and security preferences.</p>
  </header>

  <%= render "devise/shared/error_messages", resource: resource %>

  <section class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
    <h2 class="text-lg font-semibold text-slate-900">Profile</h2>
    <p class="mt-1 text-sm text-slate-600">Your name, email, and profile picture.</p>

    <%= form_for(resource,
                 as: resource_name,
                 url: registration_path(resource_name),
                 html: { method: :put, multipart: true, class: "mt-6 space-y-5" }) do |f| %>
      <div class="flex items-center gap-5">
        <%= render "shared/avatar", user: resource, size: :lg %>
        <div class="flex-1 space-y-2">
          <%= f.label :avatar, "Profile picture", class: "block text-sm font-medium text-slate-700" %>
          <%= f.file_field :avatar, accept: User::AVATAR_CONTENT_TYPES.join(","),
                                    class: "block w-full text-sm text-slate-700 file:mr-3 file:rounded-md file:border-0 file:bg-slate-100 file:px-3 file:py-1.5 file:text-sm file:font-medium file:text-slate-700 hover:file:bg-slate-200" %>
          <p class="text-xs text-slate-500">PNG, JPEG, GIF, or WebP. Max 5 MB.</p>
          <% if resource.avatar.attached? %>
            <label class="flex cursor-pointer items-center gap-2 text-sm text-slate-700">
              <%= f.check_box :remove_avatar, { class: "rounded border-slate-300 text-brand-600 focus:ring-brand-500" }, "1", "0" %>
              Remove current photo
            </label>
          <% end %>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :first_name, class: "block text-sm font-medium text-slate-700" %>
          <%= f.text_field :first_name, autocomplete: "given-name",
                                        class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" %>
        </div>
        <div>
          <%= f.label :last_name, class: "block text-sm font-medium text-slate-700" %>
          <%= f.text_field :last_name, autocomplete: "family-name",
                                       class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" %>
        </div>
      </div>

      <div>
        <%= f.label :email, class: "block text-sm font-medium text-slate-700" %>
        <%= f.email_field :email, autocomplete: "email",
                                  class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" %>
        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <p class="mt-1 text-xs text-amber-600">Pending confirmation for: <%= resource.unconfirmed_email %></p>
        <% end %>
      </div>

      <div>
        <%= f.label :current_password, class: "block text-sm font-medium text-slate-700" %>
        <%= f.password_field :current_password, autocomplete: "current-password",
                                                class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" %>
        <p class="mt-1 text-xs text-slate-500">Only required if you're changing your email.</p>
      </div>

      <div class="flex justify-end">
        <%= f.submit "Save profile",
                     class: "rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2 cursor-pointer" %>
      </div>
    <% end %>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
    <h2 class="text-lg font-semibold text-slate-900">Security</h2>
    <p class="mt-1 text-sm text-slate-600">Update your password.</p>

    <%= form_for(resource,
                 as: resource_name,
                 url: registration_path(resource_name),
                 html: { method: :put, class: "mt-6 space-y-5" }) do |f| %>
      <div>
        <%= f.label :password, "New password", class: "block text-sm font-medium text-slate-700" %>
        <%= f.password_field :password, autocomplete: "new-password",
                                        class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" %>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirm new password", class: "block text-sm font-medium text-slate-700" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
                                                     class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" %>
      </div>

      <div>
        <%= f.label :current_password, class: "block text-sm font-medium text-slate-700" %>
        <%= f.password_field :current_password, autocomplete: "current-password",
                                                class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" %>
        <p class="mt-1 text-xs text-slate-500">We need your current password to confirm changes.</p>
      </div>

      <div class="flex justify-end">
        <%= f.submit "Update password",
                     class: "rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2 cursor-pointer" %>
      </div>
    <% end %>
  </section>
</div>
