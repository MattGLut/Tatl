<% content_for :title, "Account settings - NeIQhbor" %>

<div class="mx-auto mt-2 max-w-2xl space-y-6">
  <header>
    <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">Account settings</h1>
    <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Manage your profile and security preferences.</p>
  </header>

  <%= render "devise/shared/error_messages", resource: resource %>

  <section class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm dark:border-slate-700 dark:bg-slate-800">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Profile</h2>
    <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Your name, email, and profile picture.</p>

    <%= form_for(resource,
                 as: resource_name,
                 url: registration_path(resource_name),
                 html: { method: :put, multipart: true, class: "mt-6 space-y-5" }) do |f| %>
      <div class="flex items-center gap-5">
        <%= render "shared/avatar", user: resource, size: :lg %>
        <div class="flex-1 space-y-2">
          <%= f.label :avatar, "Profile picture", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
          <%= f.file_field :avatar, accept: User::AVATAR_CONTENT_TYPES.join(","),
                                    class: registration_file_field_class %>
          <p class="text-xs text-slate-500 dark:text-slate-400">PNG, JPEG, GIF, or WebP. Max 5 MB.</p>
          <% if resource.avatar.attached? %>
            <label class="flex cursor-pointer items-center gap-2 text-sm text-slate-700 dark:text-slate-300">
              <%= f.check_box :remove_avatar, { class: "rounded border-slate-300 text-brand-600 focus:ring-brand-500 dark:border-slate-600 dark:bg-slate-700" }, "1", "0" %>
              Remove current photo
            </label>
          <% end %>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :first_name, class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
          <%= f.text_field :first_name, autocomplete: "given-name",
                                        class: form_input_lg_class %>
        </div>
        <div>
          <%= f.label :last_name, class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
          <%= f.text_field :last_name, autocomplete: "family-name",
                                       class: form_input_lg_class %>
        </div>
      </div>

      <div>
        <%= f.label :email, class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
        <%= f.email_field :email, autocomplete: "email",
                                  class: form_input_lg_class %>
        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <p class="mt-1 text-xs text-amber-600 dark:text-amber-400">Pending confirmation for: <%= resource.unconfirmed_email %></p>
        <% end %>
      </div>

      <div>
        <%= f.label :current_password, class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
        <%= f.password_field :current_password, autocomplete: "current-password",
                                                class: form_input_lg_class %>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Only required if you're changing your email.</p>
      </div>

      <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-4 dark:border-slate-700 dark:bg-slate-900/30">
        <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Email preferences</h3>
        <label class="mt-2 flex items-start gap-3 text-sm text-slate-700 dark:text-slate-300">
          <%= f.check_box :announcement_emails_enabled,
                          class: "mt-0.5 rounded border-slate-300 text-brand-600 focus:ring-brand-500 dark:border-slate-600 dark:bg-slate-700" %>
          <span>Send me announcement emails from the HOA board/admin team.</span>
        </label>
      </div>

      <div class="flex justify-end">
        <%= f.submit "Save profile", class: devise_form_submit_class %>
      </div>
    <% end %>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm dark:border-slate-700 dark:bg-slate-800">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Appearance</h2>
    <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Choose how the portal looks to you.</p>

    <div class="mt-6 flex gap-3">
      <button type="button"
              aria-pressed="false"
              class="<%= theme_appearance_mode_button_class %>"
              data-theme-target="modeButton"
              data-theme-mode-param="system"
              data-action="click->theme#setMode">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25A2.25 2.25 0 0 1 5.25 3h13.5A2.25 2.25 0 0 1 21 5.25Z" /></svg>
        System
      </button>
      <button type="button"
              aria-pressed="false"
              class="<%= theme_appearance_mode_button_class %>"
              data-theme-target="modeButton"
              data-theme-mode-param="light"
              data-action="click->theme#setMode">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" /></svg>
        Light
      </button>
      <button type="button"
              aria-pressed="false"
              class="<%= theme_appearance_mode_button_class %>"
              data-theme-target="modeButton"
              data-theme-mode-param="dark"
              data-action="click->theme#setMode">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" /></svg>
        Dark
      </button>
    </div>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm dark:border-slate-700 dark:bg-slate-800">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Security</h2>
    <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Update your password.</p>

    <%= form_for(resource,
                 as: resource_name,
                 url: registration_path(resource_name),
                 html: { method: :put, class: "mt-6 space-y-5" }) do |f| %>
      <div>
        <%= f.label :password, "New password", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
        <%= f.password_field :password, autocomplete: "new-password",
                                        class: form_input_lg_class %>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirm new password", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
                                                     class: form_input_lg_class %>
      </div>

      <div>
        <%= f.label :current_password, class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
        <%= f.password_field :current_password, autocomplete: "current-password",
                                                class: form_input_lg_class %>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">We need your current password to confirm changes.</p>
      </div>

      <div class="flex justify-end">
        <%= f.submit "Update password", class: devise_form_submit_class %>
      </div>
    <% end %>
  </section>
</div>
