<% if resource.errors.any? %>
  <div class="rounded-md border border-rose-200 bg-rose-50 p-4 dark:border-rose-800 dark:bg-rose-900/30">
    <h3 class="text-sm font-semibold text-rose-800 dark:text-rose-300">
      <%= pluralize(resource.errors.count, "error") %> prevented this action:
    </h3>
    <ul class="mt-2 list-inside list-disc text-sm text-rose-700 dark:text-rose-400">
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
