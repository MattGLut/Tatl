<% content_for :title, "Reset password - NeIQhbor" %>

<div class="mx-auto mt-8 max-w-md">
  <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm dark:border-slate-700 dark:bg-slate-800">
    <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">Set a new password</h1>
    <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Choose a strong password for your account.</p>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "mt-6 space-y-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div>
        <%= f.label :password, "New password", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password",
                                        class: form_input_lg_class %>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400"><%= @minimum_password_length %> characters minimum</p>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirm new password", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
                                                     class: form_input_lg_class %>
      </div>

      <%= f.submit "Reset password", class: devise_wfull_submit_class %>
    <% end %>

    <div class="mt-6 space-y-2 text-center text-sm">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
