<table width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;margin:0 auto;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1e293b;">
  <tr>
    <td style="padding:32px 24px;">
      <h1 style="margin:0 0 16px;font-size:22px;font-weight:700;color:#1e293b;">Email changed</h1>
      <p style="margin:0 0 8px;font-size:15px;line-height:1.6;color:#475569;">Hi <%= @resource.first_name.presence || @resource.email %>,</p>
      <% if @resource.try(:unconfirmed_email?) %>
        <p style="margin:0;font-size:15px;line-height:1.6;color:#475569;">
          We're contacting you to notify you that your email is being changed to <strong><%= @resource.unconfirmed_email %></strong>.
        </p>
      <% else %>
        <p style="margin:0;font-size:15px;line-height:1.6;color:#475569;">
          We're contacting you to notify you that your email has been changed to <strong><%= @resource.email %></strong>.
        </p>
      <% end %>
    </td>
  </tr>
</table>
