<table width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;margin:0 auto;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1e293b;">
  <tr>
    <td style="padding:32px 24px;">
      <h1 style="margin:0 0 16px;font-size:22px;font-weight:700;color:#1e293b;">Unlock your account</h1>
      <p style="margin:0 0 8px;font-size:15px;line-height:1.6;color:#475569;">Hi <%= @resource.first_name.presence || @resource.email %>,</p>
      <p style="margin:0 0 24px;font-size:15px;line-height:1.6;color:#475569;">
        Your account has been locked due to too many failed sign-in attempts. Click the button below to unlock it.
      </p>
      <p style="margin:0 0 24px;">
        <a href="<%= unlock_url(@resource, unlock_token: @token) %>"
           style="display:inline-block;padding:12px 28px;background-color:#339e3d;color:#ffffff;font-size:14px;font-weight:600;text-decoration:none;border-radius:8px;">
          Unlock my account
        </a>
      </p>
      <p style="margin:0;font-size:13px;line-height:1.6;color:#94a3b8;">
        If the button doesn't work, copy and paste this URL into your browser:<br>
        <%= unlock_url(@resource, unlock_token: @token) %>
      </p>
    </td>
  </tr>
</table>
