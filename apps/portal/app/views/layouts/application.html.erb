<!DOCTYPE html>
<html class="h-full bg-slate-50">
  <head>
    <title><%= content_for(:title) || "NeIQhbor" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="NeIQhbor">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full text-slate-900 antialiased">
    <%= render "shared/application_header" %>

    <% if notice.present? %>
      <div class="mx-auto mt-4 max-w-6xl rounded-md border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm text-emerald-800"><%= notice %></div>
    <% end %>
    <% if alert.present? %>
      <div class="mx-auto mt-4 max-w-6xl rounded-md border border-rose-200 bg-rose-50 px-4 py-2 text-sm text-rose-800"><%= alert %></div>
    <% end %>

    <main class="mx-auto max-w-6xl px-6 py-10">
      <%= yield %>
    </main>
  </body>
</html>
