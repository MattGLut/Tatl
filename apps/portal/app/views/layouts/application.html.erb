<!DOCTYPE html>
<html class="h-full bg-slate-50">
  <head>
    <title><%= content_for(:title) || "NeIQhbor" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="NeIQhbor">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full text-slate-900 antialiased">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
        <%= link_to root_path, class: "flex items-center gap-2 text-lg font-semibold tracking-tight text-navy-800" do %>
          <svg width="32" height="32" class="h-8 w-8 shrink-0" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
            <rect width="512" height="512" rx="96" fill="#1b2a4a" />
            <polygon points="256,100 120,210 150,210 150,340 362,340 362,210 392,210" fill="#3da84a" />
            <rect x="170" y="210" width="172" height="130" fill="#ffffff" />
            <rect x="230" y="270" width="52" height="70" rx="4" fill="#1b2a4a" />
            <rect x="185" y="230" width="35" height="30" rx="3" fill="#1b2a4a" />
            <rect x="292" y="230" width="35" height="30" rx="3" fill="#1b2a4a" />
          </svg>
          <span>ne<span class="text-brand-600">iQ</span>hbor</span>
        <% end %>

        <nav class="flex items-center gap-4 text-sm">
          <% if user_signed_in? %>
            <%= link_to "Properties", properties_path, class: "text-slate-600 hover:text-brand-600" %>
            <%= link_to "Documents", documents_path, class: "text-slate-600 hover:text-brand-600" %>
            <%= link_to "Tickets", tickets_tickets_path, class: "text-slate-600 hover:text-brand-600" %>
            <%= link_to "Dues", accounting_dues_assessments_path, class: "text-slate-600 hover:text-brand-600" %>
            <% if current_user.admin? || current_user.board? || current_user.treasurer? %>
              <div class="relative group">
                <button type="button" class="cursor-pointer text-slate-600 hover:text-brand-600">Accounting</button>
                <div class="invisible absolute right-0 top-full z-10 w-48 pt-1 group-hover:visible group-focus-within:visible">
                  <div class="rounded-md border border-slate-200 bg-white py-1 shadow-lg">
                    <%= link_to "Accounts", accounting_accounts_path, class: "block px-4 py-2 text-sm text-slate-700 hover:bg-slate-100" %>
                    <%= link_to "Transactions", accounting_transactions_path, class: "block px-4 py-2 text-sm text-slate-700 hover:bg-slate-100" %>
                    <%= link_to "Budget", accounting_budget_lines_path, class: "block px-4 py-2 text-sm text-slate-700 hover:bg-slate-100" %>
                    <hr class="my-1 border-slate-200">
                    <%= link_to "Summary Report", accounting_reports_summary_path, class: "block px-4 py-2 text-sm text-slate-700 hover:bg-slate-100" %>
                    <%= link_to "Dues Aging", accounting_reports_dues_aging_path, class: "block px-4 py-2 text-sm text-slate-700 hover:bg-slate-100" %>
                    <%= link_to "Reserve Balance", accounting_reports_reserve_balance_path, class: "block px-4 py-2 text-sm text-slate-700 hover:bg-slate-100" %>
                  </div>
                </div>
              </div>
            <% end %>
            <span class="text-slate-600">Hi, <%= current_user.display_name %></span>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "rounded-md border border-slate-300 px-3 py-1.5 hover:bg-slate-100" %>
          <% else %>
            <%= link_to "Sign in", new_user_session_path, class: "rounded-md border border-slate-300 px-3 py-1.5 hover:bg-slate-100" %>
            <%= link_to "Sign up", new_user_registration_path, class: "rounded-md bg-brand-600 px-3 py-1.5 text-white hover:bg-brand-700" %>
          <% end %>
        </nav>
      </div>
    </header>

    <% if notice.present? %>
      <div class="mx-auto mt-4 max-w-6xl rounded-md border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm text-emerald-800"><%= notice %></div>
    <% end %>
    <% if alert.present? %>
      <div class="mx-auto mt-4 max-w-6xl rounded-md border border-rose-200 bg-rose-50 px-4 py-2 text-sm text-rose-800"><%= alert %></div>
    <% end %>

    <main class="mx-auto max-w-6xl px-6 py-10">
      <%= yield %>
    </main>
  </body>
</html>
