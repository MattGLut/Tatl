<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-800">
  <div class="flex items-center justify-between gap-4">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Documents</h2>
    <%= link_to "Library", documents_path, class: "text-sm font-medium text-brand-600 hover:text-brand-800 dark:text-brand-400 dark:hover:text-brand-300" %>
  </div>
  <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Recently added items you can access.</p>

  <% if @recent_documents.any? %>
    <ul class="mt-4 space-y-2">
      <% @recent_documents.each do |doc| %>
        <li>
          <%= link_to document_path(doc), class: "text-sm font-medium text-brand-600 hover:text-brand-800 dark:text-brand-400 dark:hover:text-brand-300" do %>
            <span class="line-clamp-1"><%= doc.title %></span>
          <% end %>
          <p class="text-xs text-slate-500 dark:text-slate-400"><%= doc.category.humanize %><% if doc.published? %> &middot; published<% else %> &middot; draft<% end %></p>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-4 text-sm text-slate-500 dark:text-slate-400">No documents to list yet.</p>
  <% end %>

  <% if policy(Document).create? %>
    <p class="mt-4">
      <%= link_to "Upload document", new_document_path, class: "text-sm font-medium text-brand-600 hover:text-brand-800 dark:text-brand-400 dark:hover:text-brand-300" %>
    </p>
  <% end %>
</div>
