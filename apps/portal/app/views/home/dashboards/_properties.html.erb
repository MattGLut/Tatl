<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-800">
  <div class="flex items-center justify-between gap-4">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Properties</h2>
    <%= link_to "View all", properties_path, class: "text-sm font-medium text-brand-600 hover:text-brand-800 dark:text-brand-400 dark:hover:text-brand-300" %>
  </div>

  <% if @properties.any? %>
    <ul class="mt-4 divide-y divide-slate-100 dark:divide-slate-700">
      <% @properties.each do |property| %>
        <li class="py-3 first:pt-0">
          <%= link_to property_path(property), class: "group flex items-start justify-between gap-2" do %>
            <span class="font-medium text-slate-900 group-hover:text-brand-600 dark:text-slate-100 dark:group-hover:text-brand-400"><%= property.name %></span>
            <span class="shrink-0 text-xs text-slate-500 dark:text-slate-400"><%= property.property_type.humanize %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-4 text-sm text-slate-500 dark:text-slate-400">No properties to show yet.</p>
  <% end %>
</div>
