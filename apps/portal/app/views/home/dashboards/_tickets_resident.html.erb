<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 class="text-lg font-semibold text-slate-900">Your tickets</h2>
    <span class="text-sm text-slate-500"><%= @active_ticket_count %> open</span>
  </div>
  <p class="mt-1 text-sm text-slate-500">Requests and updates you&rsquo;ve submitted.</p>

  <% if @recent_tickets.any? %>
    <ul class="mt-4 space-y-3">
      <% @recent_tickets.each do |ticket| %>
        <li>
          <%= link_to tickets_ticket_path(ticket), class: "block rounded-lg border border-slate-100 bg-slate-50/60 px-3 py-2 text-sm transition hover:border-brand-200 hover:bg-white" do %>
            <div class="flex min-w-0 items-start gap-2">
              <span class="min-w-0 flex-1 truncate font-medium text-slate-900" title="<%= ticket.subject %>"><%= ticket.subject %></span>
              <span class="shrink-0 text-right text-xs text-slate-500"><%= ticket.status.titleize %></span>
            </div>
            <% if ticket.property %>
              <p class="mt-0.5 text-xs text-slate-500"><%= ticket.property.name %></p>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-4 text-sm text-slate-500">You haven&rsquo;t opened any tickets yet.</p>
  <% end %>

  <p class="mt-4">
    <%= link_to "View all tickets", tickets_tickets_path, class: "text-sm font-medium text-brand-600 hover:text-brand-800" %>
    <span class="text-slate-300">&nbsp;&middot;&nbsp;</span>
    <%= link_to "New ticket", new_tickets_ticket_path, class: "text-sm font-medium text-brand-600 hover:text-brand-800" %>
  </p>
</div>
