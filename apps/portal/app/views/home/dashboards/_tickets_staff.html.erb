<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-800">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Support tickets</h2>
    <span class="rounded-full bg-amber-50 px-2.5 py-0.5 text-sm font-medium text-amber-900 dark:bg-amber-900/30 dark:text-amber-300">
      <%= @active_ticket_count %> open or in progress
    </span>
  </div>
  <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">All association tickets (newest first).</p>

  <% if @recent_tickets.any? %>
    <ul class="mt-4 space-y-3">
      <% @recent_tickets.each do |ticket| %>
        <li>
          <%= link_to tickets_ticket_path(ticket), class: dashboard_ticket_link_class do %>
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <span class="font-medium text-slate-900 line-clamp-1 dark:text-slate-100"><%= ticket.subject %></span>
              <span class="text-xs text-slate-500 dark:text-slate-400">
                <%= ticket.user.display_name %> &middot; <%= ticket.status.titleize %>
              </span>
            </div>
            <% if ticket.property %>
              <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400"><%= ticket.property.name %></p>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-4 text-sm text-slate-500 dark:text-slate-400">No tickets in the system yet.</p>
  <% end %>

  <p class="mt-4">
    <%= link_to "View all tickets", tickets_tickets_path, class: "text-sm font-medium text-brand-600 hover:text-brand-800 dark:text-brand-400 dark:hover:text-brand-300" %>
  </p>
</div>
