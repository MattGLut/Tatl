<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 class="text-lg font-semibold text-slate-900">Support tickets</h2>
    <span class="rounded-full bg-amber-50 px-2.5 py-0.5 text-sm font-medium text-amber-900">
      <%= @active_ticket_count %> open or in progress
    </span>
  </div>
  <p class="mt-1 text-sm text-slate-500">All association tickets (newest first).</p>

  <% if @recent_tickets.any? %>
    <ul class="mt-4 space-y-3">
      <% @recent_tickets.each do |ticket| %>
        <li>
          <%= link_to tickets_ticket_path(ticket), class: "block rounded-lg border border-slate-100 bg-slate-50/60 px-3 py-2 text-sm transition hover:border-indigo-200 hover:bg-white" do %>
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <span class="font-medium text-slate-900 line-clamp-1"><%= ticket.subject %></span>
              <span class="text-xs text-slate-500">
                <%= ticket.user.display_name %> &middot; <%= ticket.status.titleize %>
              </span>
            </div>
            <% if ticket.property %>
              <p class="mt-0.5 text-xs text-slate-500"><%= ticket.property.name %></p>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-4 text-sm text-slate-500">No tickets in the system yet.</p>
  <% end %>

  <p class="mt-4">
    <%= link_to "View all tickets", tickets_tickets_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-800" %>
  </p>
</div>
