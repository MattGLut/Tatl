<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 class="text-lg font-semibold text-slate-900">Dues</h2>
    <% if @dues_overdue_count.positive? %>
      <span class="rounded-full bg-rose-50 px-2.5 py-0.5 text-sm font-medium text-rose-800">
        <%= @dues_overdue_count %> overdue
      </span>
    <% else %>
      <span class="text-sm text-slate-500">No overdue balances</span>
    <% end %>
  </div>
  <p class="mt-1 text-sm text-slate-500">Assessments that are open or partially paid (soonest due first).</p>

  <% if @dues_outstanding.any? %>
    <ul class="mt-4 divide-y divide-slate-100">
      <% @dues_outstanding.each do |assessment| %>
        <li class="py-3 first:pt-0">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <%= link_to assessment.property.name, accounting_dues_assessment_path(assessment), class: "font-medium text-indigo-600 hover:text-indigo-800" %>
            <span class="text-sm font-medium text-slate-900 tabular-nums">
              <%= humanized_money_with_symbol(assessment.amount) %>
            </span>
          </div>
          <p class="mt-0.5 text-xs text-slate-500">
            Due <%= assessment.due_date.strftime("%b %d, %Y") %> &middot; <%= assessment.status.titleize %>
          </p>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-4 text-sm text-slate-500">No open or partial assessments right now.</p>
  <% end %>

  <p class="mt-4">
    <%= link_to "Dues & payments", accounting_dues_assessments_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-800" %>
  </p>
</div>
