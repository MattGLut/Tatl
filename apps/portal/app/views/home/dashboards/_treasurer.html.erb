<div class="rounded-2xl border border-brand-200 bg-brand-50/40 p-6 dark:border-brand-800 dark:bg-brand-900/20">
  <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Accounting &amp; reporting</h2>
  <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Quick access to money reports and the chart of accounts.</p>
  <ul class="mt-4 flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:gap-4">
    <li>
      <%= link_to "Dues aging", accounting_reports_dues_aging_path, class: "text-sm font-medium text-brand-700 hover:text-brand-900 dark:text-brand-400 dark:hover:text-brand-300" %>
    </li>
    <li>
      <%= link_to "Reserve balance", accounting_reports_reserve_balance_path, class: "text-sm font-medium text-brand-700 hover:text-brand-900 dark:text-brand-400 dark:hover:text-brand-300" %>
    </li>
    <li>
      <%= link_to "Summary report", accounting_reports_summary_path, class: "text-sm font-medium text-brand-700 hover:text-brand-900 dark:text-brand-400 dark:hover:text-brand-300" %>
    </li>
    <li>
      <%= link_to "All assessments", accounting_dues_assessments_path, class: "text-sm font-medium text-brand-700 hover:text-brand-900 dark:text-brand-400 dark:hover:text-brand-300" %>
    </li>
  </ul>
</div>
