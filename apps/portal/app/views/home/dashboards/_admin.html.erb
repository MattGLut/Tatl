<div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-700 dark:bg-slate-800/50">
  <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Administration</h2>
  <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Manage the directory and the association record.</p>
  <% if policy(Property.new).create? %>
    <p class="mt-4">
      <%= link_to "Add property", new_property_path, class: "text-sm font-medium text-brand-600 hover:text-brand-800 dark:text-brand-400 dark:hover:text-brand-300" %>
    </p>
  <% end %>
</div>
