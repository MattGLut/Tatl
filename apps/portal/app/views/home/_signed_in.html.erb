<div class="space-y-6">
  <%= render "home/dashboards/heading" %>

  <% if current_user.staff? %>
    <div class="space-y-6">
      <div class="grid gap-6 lg:grid-cols-2">
        <%= render "home/dashboards/properties" %>
        <%= render "home/dashboards/tickets_staff" %>
      </div>
      <div class="grid gap-6 lg:grid-cols-2">
        <%= render "home/dashboards/dues" %>
        <%= render "home/dashboards/documents" %>
      </div>
    </div>

    <div class="space-y-4">
      <% if current_user.treasurer? || current_user.admin? %>
        <%= render "home/dashboards/treasurer" %>
      <% end %>
      <% if current_user.admin? %>
        <%= render "home/dashboards/admin" %>
      <% end %>
    </div>
  <% else %>
    <div class="grid gap-6 lg:grid-cols-2">
      <%= render "home/dashboards/properties" %>
      <%= render "home/dashboards/tickets_resident" %>
    </div>
    <div class="grid gap-6 lg:grid-cols-2">
      <%= render "home/dashboards/dues" %>
      <%= render "home/dashboards/documents" %>
    </div>
  <% end %>
</div>
