<% content_for :title, "Tatl - HOA portal" %>

<section class="rounded-2xl border border-slate-200 bg-white p-10 shadow-sm">
  <p class="text-sm font-semibold uppercase tracking-wider text-indigo-600">Slice 1 - foundation</p>
  <h1 class="mt-2 text-4xl font-bold tracking-tight text-slate-900">Welcome to Tatl</h1>
  <p class="mt-4 max-w-2xl text-lg text-slate-600">
    A resident portal for HOA policies, accounting, tickets, and a knowledge-graph chat assistant.
    This is the Rails app foundation - authentication, authorization, and tests are wired up.
    Helpdesk, forum, RAG, and more come in later slices. Now auto-deployed to staging.
  </p>

  <div class="mt-8 grid gap-4 sm:grid-cols-3">
    <div class="rounded-xl border border-slate-200 p-4">
      <h2 class="font-semibold text-slate-900">Authentication</h2>
      <p class="mt-1 text-sm text-slate-600">Devise with confirmable, lockable, and trackable.</p>
    </div>
    <div class="rounded-xl border border-slate-200 p-4">
      <h2 class="font-semibold text-slate-900">Authorization</h2>
      <p class="mt-1 text-sm text-slate-600">Pundit policies driven by user roles.</p>
    </div>
    <div class="rounded-xl border border-slate-200 p-4">
      <h2 class="font-semibold text-slate-900">Tested</h2>
      <p class="mt-1 text-sm text-slate-600">RSpec, FactoryBot, Capybara, WebMock, and SimpleCov.</p>
    </div>
  </div>

  <% if user_signed_in? %>
    <p class="mt-8 text-sm text-slate-500">
      You're signed in as <strong class="text-slate-700"><%= current_user.email %></strong>
      with role <strong class="text-slate-700"><%= current_user.role.humanize %></strong>.
    </p>
  <% else %>
    <p class="mt-8 text-sm text-slate-500">
      <%= link_to "Sign up", new_user_registration_path, class: "font-medium text-indigo-600 hover:text-indigo-500" %>
      or <%= link_to "sign in", new_user_session_path, class: "font-medium text-indigo-600 hover:text-indigo-500" %>
      to see the role banner change.
    </p>
  <% end %>
</section>
