<div style="background:#ffffff;border:1px solid #dce3ee;border-radius:12px;padding:24px;">
  <p style="margin:0 0 8px 0;color:#1b2a4a;font-size:14px;font-weight:700;">Community announcement</p>
  <h1 style="margin:0 0 12px 0;color:#0f172a;font-size:20px;line-height:1.3;"><%= @announcement.title %></h1>

  <p style="margin:0;color:#334155;font-size:15px;line-height:1.6;white-space:pre-line;"><%= @announcement.body %></p>
</div>
