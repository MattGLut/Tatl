<%= form_with(model: property, class: "space-y-6") do |f| %>
  <% if property.errors.any? %>
    <div class="rounded-md border border-rose-200 bg-rose-50 p-4">
      <h3 class="text-sm font-medium text-rose-800"><%= pluralize(property.errors.count, "error") %> prevented this property from being saved:</h3>
      <ul class="mt-2 list-inside list-disc text-sm text-rose-700">
        <% property.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid gap-6 sm:grid-cols-2">
    <div class="sm:col-span-2">
      <%= f.label :name, class: "block text-sm font-medium text-slate-700" %>
      <%= f.text_field :name, class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500", placeholder: "e.g. Unit 101" %>
    </div>

    <div>
      <%= f.label :property_type, class: "block text-sm font-medium text-slate-700" %>
      <%= f.select :property_type, Property.property_types.keys.map { |t| [t.humanize, t] }, {}, class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500" %>
    </div>

    <div>
      <%= f.label :lot_number, class: "block text-sm font-medium text-slate-700" %>
      <%= f.text_field :lot_number, class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500" %>
    </div>

    <div class="sm:col-span-2">
      <%= f.label :street_address, class: "block text-sm font-medium text-slate-700" %>
      <%= f.text_field :street_address, class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500" %>
    </div>

    <div>
      <%= f.label :city, class: "block text-sm font-medium text-slate-700" %>
      <%= f.text_field :city, class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500" %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :state, class: "block text-sm font-medium text-slate-700" %>
        <%= f.text_field :state, class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500", maxlength: 2 %>
      </div>
      <div>
        <%= f.label :zip, class: "block text-sm font-medium text-slate-700" %>
        <%= f.text_field :zip, class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500" %>
      </div>
    </div>

    <div class="sm:col-span-2">
      <%= f.label :notes, class: "block text-sm font-medium text-slate-700" %>
      <%= f.text_area :notes, rows: 3, class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500" %>
    </div>
  </div>

  <div class="flex justify-end gap-3">
    <%= link_to "Cancel", (property.persisted? ? property_path(property) : properties_path), class: "rounded-md border border-slate-300 px-4 py-2 text-sm hover:bg-slate-100" %>
    <%= f.submit class: "rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700 cursor-pointer" %>
  </div>
<% end %>
