<% content_for :title, "Properties - NeIQhbor" %>

<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold tracking-tight text-slate-900">Properties</h1>
  <% if policy(Property).create? %>
    <%= link_to "Add property", new_property_path, class: "rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700" %>
  <% end %>
</div>

<% if @properties.any? %>
  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @properties.each do |property| %>
      <%= link_to property_path(property), class: "group rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-brand-300 hover:shadow-md" do %>
        <div class="flex items-start justify-between">
          <h2 class="font-semibold text-slate-900 group-hover:text-brand-600"><%= property.name %></h2>
          <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600"><%= property.property_type.humanize %></span>
        </div>
        <% if property.street_address.present? %>
          <p class="mt-2 text-sm text-slate-500">
            <%= property.street_address %><br>
            <%= [property.city, property.state].compact_blank.join(", ") %> <%= property.zip %>
          </p>
        <% end %>
        <% if property.lot_number.present? %>
          <p class="mt-1 text-xs text-slate-400">Lot <%= property.lot_number %></p>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="mt-8 rounded-xl border border-dashed border-slate-300 p-10 text-center">
    <p class="text-sm text-slate-500">No properties found.</p>
  </div>
<% end %>
