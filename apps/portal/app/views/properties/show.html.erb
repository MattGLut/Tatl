<% content_for :title, "#{@property.name} - NeIQhbor" %>

<div class="flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100"><%= @property.name %></h1>
    <span class="mt-1 inline-block rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-600 dark:bg-slate-700 dark:text-slate-300"><%= @property.property_type.humanize %></span>
  </div>
  <div class="flex gap-2">
    <% if policy(@property).update? %>
      <%= link_to "Edit", edit_property_path(@property), class: "rounded-md border border-slate-300 px-3 py-1.5 text-sm hover:bg-slate-100 dark:border-slate-600 dark:hover:bg-slate-700" %>
    <% end %>
    <% if policy(@property).destroy? %>
      <%= button_to "Delete", property_path(@property),
                    method: :delete,
                    class: "cursor-pointer rounded-md border border-rose-300 px-3 py-1.5 text-sm text-rose-600 hover:bg-rose-50 dark:border-rose-700 dark:text-rose-400 dark:hover:bg-rose-900/30",
                    data: { turbo_confirm: "Are you sure you want to delete this property?" } %>
    <% end %>
    <%= link_to "Back", properties_path, class: "rounded-md border border-slate-300 px-3 py-1.5 text-sm hover:bg-slate-100 dark:border-slate-600 dark:hover:bg-slate-700" %>
  </div>
</div>

<section class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-800">
  <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">Details</h2>
  <dl class="mt-4 grid gap-4 sm:grid-cols-2">
    <% if @property.street_address.present? %>
      <div>
        <dt class="text-xs font-medium text-slate-500 dark:text-slate-400">Address</dt>
        <dd class="mt-1 text-sm text-slate-900 dark:text-slate-100">
          <%= @property.street_address %><br>
          <%= [@property.city, @property.state].compact_blank.join(", ") %> <%= @property.zip %>
        </dd>
      </div>
    <% end %>
    <% if @property.lot_number.present? %>
      <div>
        <dt class="text-xs font-medium text-slate-500 dark:text-slate-400">Lot number</dt>
        <dd class="mt-1 text-sm text-slate-900 dark:text-slate-100"><%= @property.lot_number %></dd>
      </div>
    <% end %>
    <% if @property.notes.present? %>
      <div class="sm:col-span-2">
        <dt class="text-xs font-medium text-slate-500 dark:text-slate-400">Notes</dt>
        <dd class="mt-1 text-sm text-slate-900 dark:text-slate-100"><%= simple_format(@property.notes) %></dd>
      </div>
    <% end %>
  </dl>
</section>

<section class="mt-8">
  <div class="flex items-center justify-between">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Members</h2>
    <% if policy(Membership).create? %>
      <%= link_to "Add member", new_property_membership_path(@property), class: "rounded-md bg-brand-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-brand-700" %>
    <% end %>
  </div>

  <% if @property.memberships.active.includes(:user).any? %>
    <div class="mt-4 overflow-hidden rounded-lg border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800">
      <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-700">
        <thead class="bg-slate-50 dark:bg-slate-800/80">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-500 dark:text-slate-400">Name</th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-500 dark:text-slate-400">Role</th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-500 dark:text-slate-400">Since</th>
            <% if policy(Membership).update? %>
              <th class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-slate-500 dark:text-slate-400">Actions</th>
            <% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
          <% @property.memberships.active.includes(:user).to_a.each do |membership| %>
            <tr>
              <td class="px-4 py-3 text-sm text-slate-900 dark:text-slate-100"><%= membership.user.display_name %></td>
              <td class="px-4 py-3 text-sm"><span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600 dark:bg-slate-700 dark:text-slate-300"><%= membership.role.humanize %></span></td>
              <td class="px-4 py-3 text-sm text-slate-500 dark:text-slate-400"><%= membership.started_on.strftime("%b %d, %Y") %></td>
              <% if policy(membership).update? %>
                <td class="px-4 py-3 text-right text-sm">
                  <%= link_to "Edit", edit_property_membership_path(@property, membership),
                              class: "text-brand-600 hover:text-brand-800 dark:text-brand-400 dark:hover:text-brand-300" %>
                  <%= button_to "Remove", property_membership_path(@property, membership),
                                method: :delete,
                                class: "ml-3 cursor-pointer text-rose-600 hover:text-rose-800 dark:text-rose-400 dark:hover:text-rose-300",
                                data: { turbo_confirm: "Remove this member?" } %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="mt-4 rounded-lg border border-dashed border-slate-300 p-6 text-center dark:border-slate-600">
      <p class="text-sm text-slate-500 dark:text-slate-400">No active members.</p>
    </div>
  <% end %>
</section>
