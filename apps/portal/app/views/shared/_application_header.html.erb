<header
  class="border-b border-slate-200 bg-white"
  data-controller="mobile-nav"
  data-action="keydown@window->mobile-nav#keydown"
>
  <div class="mx-auto max-w-6xl">
    <div class="flex items-center justify-between gap-4 px-6 py-4">
      <%= link_to root_path, class: "flex min-w-0 items-center gap-2 text-lg font-semibold tracking-tight text-navy-800" do %>
        <svg width="32" height="32" class="h-8 w-8 shrink-0" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
          <rect width="512" height="512" rx="96" fill="#1b2a4a" />
          <polygon points="256,100 120,210 150,210 150,340 362,340 362,210 392,210" fill="#3da84a" />
          <rect x="170" y="210" width="172" height="130" fill="#ffffff" />
          <rect x="230" y="270" width="52" height="70" rx="4" fill="#1b2a4a" />
          <rect x="185" y="230" width="35" height="30" rx="3" fill="#1b2a4a" />
          <rect x="292" y="230" width="35" height="30" rx="3" fill="#1b2a4a" />
        </svg>
        <span>ne<span class="text-brand-600">iQ</span>hbor</span>
      <% end %>

      <nav class="hidden items-center gap-4 text-sm md:flex" aria-label="Main">
        <% if user_signed_in? %>
          <%= link_to "Properties", properties_path, class: "text-slate-600 hover:text-brand-600" %>
          <%= link_to "Documents", documents_path, class: "text-slate-600 hover:text-brand-600" %>
          <%= link_to "Tickets", tickets_tickets_path, class: "text-slate-600 hover:text-brand-600" %>
          <%= link_to "Dues", accounting_dues_assessments_path, class: "text-slate-600 hover:text-brand-600" %>
          <% if current_user.admin? || current_user.board? || current_user.treasurer? %>
            <div class="relative group">
              <button type="button" class="cursor-pointer text-slate-600 hover:text-brand-600">Accounting</button>
              <div class="invisible absolute right-0 top-full z-10 w-48 pt-1 group-hover:visible group-focus-within:visible">
                <div class="rounded-md border border-slate-200 bg-white py-1 shadow-lg">
                  <%= link_to "Accounts", accounting_accounts_path, class: "block px-4 py-2 text-sm text-slate-700 hover:bg-slate-100" %>
                  <%= link_to "Transactions", accounting_transactions_path, class: "block px-4 py-2 text-sm text-slate-700 hover:bg-slate-100" %>
                  <%= link_to "Budget", accounting_budget_lines_path, class: "block px-4 py-2 text-sm text-slate-700 hover:bg-slate-100" %>
                  <hr class="my-1 border-slate-200">
                  <%= link_to "Summary Report", accounting_reports_summary_path, class: "block px-4 py-2 text-sm text-slate-700 hover:bg-slate-100" %>
                  <%= link_to "Dues Aging", accounting_reports_dues_aging_path, class: "block px-4 py-2 text-sm text-slate-700 hover:bg-slate-100" %>
                  <%= link_to "Reserve Balance", accounting_reports_reserve_balance_path, class: "block px-4 py-2 text-sm text-slate-700 hover:bg-slate-100" %>
                </div>
              </div>
            </div>
          <% end %>
          <div class="relative group">
            <button type="button" class="flex cursor-pointer items-center gap-2 rounded-md p-0 text-left text-slate-600 hover:text-brand-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2">
              <%= render "shared/avatar", user: current_user, size: :sm %>
              <span class="flex h-8 items-center leading-none">Hi, <%= current_user.display_name %></span>
            </button>
            <div class="invisible absolute right-0 top-full z-10 w-48 pt-1 group-hover:visible group-focus-within:visible">
              <div class="rounded-md border border-slate-200 bg-white py-1 shadow-lg">
                <%= link_to "Account settings", edit_user_registration_path, class: "block px-4 py-2 text-sm text-slate-700 hover:bg-slate-100" %>
                <hr class="my-1 border-slate-200">
                <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "block w-full px-4 py-2 text-left text-sm text-slate-700 hover:bg-slate-100 cursor-pointer" %>
              </div>
            </div>
          </div>
        <% else %>
          <%= link_to "Sign in", new_user_session_path, class: "rounded-md border border-slate-300 px-3 py-1.5 hover:bg-slate-100" %>
          <%= link_to "Sign up", new_user_registration_path, class: "rounded-md bg-brand-600 px-3 py-1.5 text-white hover:bg-brand-700" %>
        <% end %>
      </nav>

      <div class="shrink-0 md:hidden">
        <button
          type="button"
          class="inline-flex h-10 w-10 items-center justify-center rounded-md text-slate-600 hover:bg-slate-100 hover:text-brand-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2"
          data-action="click->mobile-nav#toggle"
          data-mobile-nav-target="button"
          aria-controls="mobile-nav-panel"
          aria-expanded="false"
          aria-label="Open main menu"
        >
          <svg
            class="h-5 w-5"
            data-mobile-nav-target="iconMenu"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path stroke-linecap="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
          </svg>
          <svg
            class="hidden h-5 w-5"
            data-mobile-nav-target="iconClose"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path stroke-linecap="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <div
      id="mobile-nav-panel"
      class="hidden border-t border-slate-200 bg-white md:hidden"
      data-mobile-nav-target="panel"
      data-action="click->mobile-nav#handlePanelNavigate"
      aria-hidden="true"
    >
      <div class="flex flex-col gap-1 px-6 py-3 text-sm">
        <% if user_signed_in? %>
          <%= link_to "Properties", properties_path, class: "rounded-md px-2 py-2 text-slate-700 hover:bg-slate-100" %>
          <%= link_to "Documents", documents_path, class: "rounded-md px-2 py-2 text-slate-700 hover:bg-slate-100" %>
          <%= link_to "Tickets", tickets_tickets_path, class: "rounded-md px-2 py-2 text-slate-700 hover:bg-slate-100" %>
          <%= link_to "Dues", accounting_dues_assessments_path, class: "rounded-md px-2 py-2 text-slate-700 hover:bg-slate-100" %>
          <% if current_user.admin? || current_user.board? || current_user.treasurer? %>
            <details class="group">
              <summary
                class="list-none cursor-pointer select-none rounded-md px-2 py-2 text-slate-700 hover:bg-slate-100 [&::-webkit-details-marker]:hidden"
              >
                <span class="block">Accounting</span>
              </summary>
              <div class="mt-1 flex flex-col border-l-2 border-slate-200 pl-3 text-sm">
                <%= link_to "Accounts", accounting_accounts_path, class: "py-1.5 text-slate-600 hover:text-brand-600" %>
                <%= link_to "Transactions", accounting_transactions_path, class: "py-1.5 text-slate-600 hover:text-brand-600" %>
                <%= link_to "Budget", accounting_budget_lines_path, class: "py-1.5 text-slate-600 hover:text-brand-600" %>
                <hr class="my-1 border-slate-200">
                <%= link_to "Summary Report", accounting_reports_summary_path, class: "py-1.5 text-slate-600 hover:text-brand-600" %>
                <%= link_to "Dues Aging", accounting_reports_dues_aging_path, class: "py-1.5 text-slate-600 hover:text-brand-600" %>
                <%= link_to "Reserve Balance", accounting_reports_reserve_balance_path, class: "py-1.5 text-slate-600 hover:text-brand-600" %>
              </div>
            </details>
          <% end %>

          <div class="mt-2 border-t border-slate-200 pt-3">
            <div class="mb-2 flex items-center gap-2 px-2 text-slate-500">
              <%= render "shared/avatar", user: current_user, size: :sm %>
              <span class="text-sm">Hi, <%= current_user.display_name %></span>
            </div>
            <%= link_to "Account settings", edit_user_registration_path, class: "block rounded-md px-2 py-2 text-slate-700 hover:bg-slate-100" %>
            <div>
              <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "mt-1 w-full cursor-pointer rounded-md border-0 bg-transparent px-2 py-2 text-left text-sm text-slate-700 hover:bg-slate-100" %>
            </div>
          </div>
        <% else %>
          <div class="flex flex-col gap-2">
            <%= link_to "Sign in", new_user_session_path, class: "rounded-md border border-slate-300 px-3 py-2 text-center hover:bg-slate-100" %>
            <%= link_to "Sign up", new_user_registration_path, class: "rounded-md bg-brand-600 px-3 py-2 text-center text-white hover:bg-brand-700" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</header>
