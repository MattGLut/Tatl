<% if (announcement = Announcement.visible.first).present? %>
  <section class="border-y border-amber-300 bg-amber-50/90 dark:border-amber-900 dark:bg-amber-900/20" role="status" aria-live="polite">
    <div class="mx-auto max-w-6xl px-6 py-3">
      <p class="text-sm font-semibold text-amber-900 dark:text-amber-200"><%= announcement.title %></p>
      <p class="mt-1 whitespace-pre-line text-sm text-amber-800 dark:text-amber-300"><%= announcement.body %></p>
    </div>
  </section>
<% end %>
