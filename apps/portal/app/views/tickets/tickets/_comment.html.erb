<div id="<%= dom_id(comment) %>" class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800">
  <div class="flex items-center justify-between">
    <span class="text-sm font-medium text-slate-900 dark:text-slate-100">
      <%= comment.user.display_name %>
      <% if comment.user.admin? || comment.user.board? || comment.user.treasurer? %>
        <span class="ml-1 rounded-full bg-brand-100 px-2 py-0.5 text-xs font-medium text-brand-700 dark:bg-brand-900/30 dark:text-brand-400">Staff</span>
      <% end %>
    </span>
    <span class="text-xs text-slate-400 dark:text-slate-500"><%= comment.created_at.strftime("%b %d, %Y at %l:%M %p") %></span>
  </div>
  <div class="mt-2 text-sm text-slate-700 dark:text-slate-300"><%= simple_format(comment.body) %></div>
  <% if comment.file.attached? %>
    <div class="mt-2">
      <%= link_to rails_blob_path(comment.file, disposition: "attachment"), class: "inline-flex items-center gap-1 text-sm text-brand-600 hover:text-brand-800 dark:text-brand-400 dark:hover:text-brand-300" do %>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
        </svg>
        <%= comment.file.filename %>
      <% end %>
      <span class="ml-1 text-xs text-slate-400 dark:text-slate-500">(<%= number_to_human_size(comment.file.byte_size) %>)</span>
    </div>
  <% end %>
</div>
