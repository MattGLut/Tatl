<%= turbo_frame_tag dom_id(ticket, :comment_form) do %>
  <section class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-800">
    <h2 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Add a comment</h2>
    <%= form_with(model: comment, url: tickets_ticket_comments_path(ticket), class: "mt-3 space-y-4") do |f| %>
      <% if comment.errors.any? %>
        <div class="rounded-md border border-rose-200 bg-rose-50 p-4 dark:border-rose-800 dark:bg-rose-900/30">
          <ul class="list-inside list-disc text-sm text-rose-700 dark:text-rose-400">
            <% comment.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.text_area :body, rows: 3, placeholder: "Write your comment...", class: comment_text_area_class %>
      </div>
      <div>
        <%= f.label :file, "Attach a file (optional)", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
        <%= f.file_field :file, class: document_file_input_class %>
      </div>
      <div class="flex justify-end">
        <%= f.submit "Post comment", class: "rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700 cursor-pointer" %>
      </div>
    <% end %>
  </section>
<% end %>
