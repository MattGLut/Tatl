<% content_for :title, "#{@ticket.subject} - NeIQhbor" %>

<div class="flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-bold tracking-tight text-slate-900"><%= @ticket.subject %></h1>
    <div class="mt-1 flex flex-wrap items-center gap-2">
      <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-600"><%= @ticket.category.humanize %></span>
      <% case @ticket.status %>
      <% when "open" %>
        <span class="rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-medium text-blue-700">Open</span>
      <% when "in_progress" %>
        <span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-700">In progress</span>
      <% when "resolved" %>
        <span class="rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-medium text-emerald-700">Resolved</span>
      <% when "closed" %>
        <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-500">Closed</span>
      <% end %>
      <% case @ticket.priority %>
      <% when "high" %>
        <span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-700">High priority</span>
      <% when "urgent" %>
        <span class="rounded-full bg-rose-100 px-2.5 py-0.5 text-xs font-medium text-rose-700">Urgent</span>
      <% end %>
    </div>
  </div>
  <%= link_to "Back", tickets_tickets_path, class: "rounded-md border border-slate-300 px-3 py-1.5 text-sm hover:bg-slate-100" %>
</div>

<%# Ticket details card %>
<section class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
  <div class="text-sm text-slate-700"><%= simple_format(@ticket.description) %></div>

  <hr class="my-4 border-slate-200">

  <dl class="grid gap-4 sm:grid-cols-3 text-sm">
    <div>
      <dt class="text-xs font-medium text-slate-500">Submitted by</dt>
      <dd class="mt-1 text-slate-900"><%= @ticket.user.display_name %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium text-slate-500">Created</dt>
      <dd class="mt-1 text-slate-900"><%= @ticket.created_at.strftime("%B %d, %Y at %l:%M %p") %></dd>
    </div>
    <% if @ticket.property.present? %>
      <div>
        <dt class="text-xs font-medium text-slate-500">Property</dt>
        <dd class="mt-1 text-slate-900"><%= link_to @ticket.property.name, property_path(@ticket.property), class: "text-brand-600 hover:text-brand-800" %></dd>
      </div>
    <% end %>
    <% if @ticket.closed_at.present? %>
      <div>
        <dt class="text-xs font-medium text-slate-500">Closed</dt>
        <dd class="mt-1 text-slate-900"><%= @ticket.closed_at.strftime("%B %d, %Y at %l:%M %p") %></dd>
      </div>
    <% end %>
  </dl>
</section>

<%# Admin status/priority controls %>
<% if policy(@ticket).update_status? %>
  <section class="mt-4 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-sm font-semibold text-slate-900">Manage ticket</h2>
    <%= form_with(url: update_status_tickets_ticket_path(@ticket), method: :patch, scope: :ticket, class: "mt-3 flex flex-wrap items-end gap-4") do |f| %>
      <div>
        <%= f.label :status, class: "block text-sm font-medium text-slate-700" %>
        <%= f.select :status, Ticket.statuses.keys.map { |s| [s.humanize, s] }, { selected: @ticket.status }, class: "mt-1 block rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500" %>
      </div>
      <div>
        <%= f.label :priority, class: "block text-sm font-medium text-slate-700" %>
        <%= f.select :priority, Ticket.priorities.keys.map { |p| [p.humanize, p] }, { selected: @ticket.priority }, class: "mt-1 block rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500" %>
      </div>
      <%= f.submit "Update", class: "rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700 cursor-pointer" %>
    <% end %>
  </section>
<% end %>

<%# Comments thread %>
<section class="mt-6">
  <h2 class="text-lg font-semibold text-slate-900">Comments</h2>

  <% if @comments.any? %>
    <div class="mt-4 space-y-4">
      <% @comments.each do |comment| %>
        <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
          <div class="flex items-center justify-between">
            <span class="text-sm font-medium text-slate-900">
              <%= comment.user.display_name %>
              <% if comment.user.admin? || comment.user.board? || comment.user.treasurer? %>
                <span class="ml-1 rounded-full bg-brand-100 px-2 py-0.5 text-xs font-medium text-brand-700">Staff</span>
              <% end %>
            </span>
            <span class="text-xs text-slate-400"><%= comment.created_at.strftime("%b %d, %Y at %l:%M %p") %></span>
          </div>
          <div class="mt-2 text-sm text-slate-700"><%= simple_format(comment.body) %></div>
          <% if comment.file.attached? %>
            <div class="mt-2">
              <%= link_to rails_blob_path(comment.file, disposition: "attachment"), class: "inline-flex items-center gap-1 text-sm text-brand-600 hover:text-brand-800" do %>
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
                </svg>
                <%= comment.file.filename %>
              <% end %>
              <span class="ml-1 text-xs text-slate-400">(<%= number_to_human_size(comment.file.byte_size) %>)</span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="mt-4 text-sm text-slate-500">No comments yet.</p>
  <% end %>
</section>

<%# New comment form %>
<section class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
  <h2 class="text-sm font-semibold text-slate-900">Add a comment</h2>
  <%= form_with(model: @comment, url: tickets_ticket_comments_path(@ticket), class: "mt-3 space-y-4") do |f| %>
    <% if @comment.errors.any? %>
      <div class="rounded-md border border-rose-200 bg-rose-50 p-4">
        <ul class="list-inside list-disc text-sm text-rose-700">
          <% @comment.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.text_area :body, rows: 3, placeholder: "Write your comment...", class: "block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500" %>
    </div>
    <div>
      <%= f.label :file, "Attach a file (optional)", class: "block text-sm font-medium text-slate-700" %>
      <%= f.file_field :file, class: "mt-1 block w-full text-sm text-slate-500 file:mr-4 file:rounded-md file:border-0 file:bg-brand-50 file:px-4 file:py-2 file:text-sm file:font-medium file:text-brand-700 hover:file:bg-brand-100" %>
    </div>
    <div class="flex justify-end">
      <%= f.submit "Post comment", class: "rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700 cursor-pointer" %>
    </div>
  <% end %>
</section>
