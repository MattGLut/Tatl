<% content_for :title, "#{@ticket.subject} - NeIQhbor" %>

<%= turbo_stream_from @ticket %>

<%= render "tickets/tickets/ticket_header", ticket: @ticket %>

<%# Admin status/priority controls %>
<% if policy(@ticket).update_status? %>
  <section class="mt-4 rounded-xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-800">
    <h2 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Manage ticket</h2>
    <%= form_with(url: update_status_tickets_ticket_path(@ticket), method: :patch, scope: :ticket, class: "mt-3 flex flex-wrap items-end gap-4") do |f| %>
      <div>
        <%= f.label :status, class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
        <%= f.select :status, Ticket.statuses.keys.map { |s| [s.humanize, s] }, { selected: @ticket.status },
                     class: ticket_admin_select_class %>
      </div>
      <div>
        <%= f.label :priority, class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
        <%= f.select :priority, Ticket.priorities.keys.map { |p| [p.humanize, p] }, { selected: @ticket.priority },
                     class: ticket_admin_select_class %>
      </div>
      <%= f.submit "Update", class: "rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700 cursor-pointer" %>
    <% end %>
  </section>
<% end %>

<%# Comments thread %>
<section class="mt-6">
  <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Comments</h2>

  <div id="<%= dom_id(@ticket, :comments) %>" class="mt-4 space-y-4">
    <% if @comments.any? %>
      <%= render partial: "tickets/tickets/comment", collection: @comments, as: :comment %>
    <% end %>
  </div>

  <p id="<%= dom_id(@ticket, :no_comments) %>" class="mt-4 text-sm text-slate-500 dark:text-slate-400 <%= "hidden" if @comments.any? %>">No comments yet.</p>
</section>

<%# New comment form %>
<%= render "tickets/tickets/comment_form", ticket: @ticket, comment: @comment %>
