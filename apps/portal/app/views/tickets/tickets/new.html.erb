<% content_for :title, "New ticket - NeIQhbor" %>

<h1 class="text-2xl font-bold tracking-tight text-slate-900">New ticket</h1>

<div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
  <%= form_with(model: @ticket, url: tickets_tickets_path, class: "space-y-6") do |f| %>
    <% if @ticket.errors.any? %>
      <div class="rounded-md border border-rose-200 bg-rose-50 p-4">
        <h3 class="text-sm font-medium text-rose-800"><%= pluralize(@ticket.errors.count, "error") %> prevented this ticket from being saved:</h3>
        <ul class="mt-2 list-inside list-disc text-sm text-rose-700">
          <% @ticket.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid gap-6 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <%= f.label :subject, class: "block text-sm font-medium text-slate-700" %>
        <%= f.text_field :subject, class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500" %>
      </div>

      <div>
        <%= f.label :category, class: "block text-sm font-medium text-slate-700" %>
        <%= f.select :category, Ticket.categories.keys.map { |c| [c.humanize, c] },
                     { prompt: "Select a category" },
                     class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500" %>
      </div>

      <div>
        <%= f.label :property_id, "Related property (optional)", class: "block text-sm font-medium text-slate-700" %>
        <%= f.select :property_id, @properties.map { |p| [p.name, p.id] }, { include_blank: "None" }, class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500" %>
      </div>

      <div class="sm:col-span-2">
        <%= f.label :description, class: "block text-sm font-medium text-slate-700" %>
        <%= f.text_area :description, rows: 5, placeholder: "Describe the issue or request in detail...", class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500" %>
      </div>
    </div>

    <div class="flex justify-end gap-3">
      <%= link_to "Cancel", tickets_tickets_path, class: "rounded-md border border-slate-300 px-4 py-2 text-sm hover:bg-slate-100" %>
      <%= f.submit "Submit ticket", class: "rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700 cursor-pointer" %>
    </div>
  <% end %>
</div>
