<%= form_with(model: [:accounting, transaction], class: "space-y-6") do |f| %>
  <% if transaction.errors.any? %>
    <div class="rounded-md border border-rose-200 dark:border-rose-800 bg-rose-50 dark:bg-rose-900/30 p-4 text-sm text-rose-800 dark:text-rose-300">
      <ul class="list-inside list-disc">
        <% transaction.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :transacted_on, "Date", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
    <%= f.date_field :transacted_on, class: form_input_class %>
  </div>

  <div>
    <%= f.label :amount, class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
    <%= f.text_field :amount, value: transaction.amount.to_f.nonzero?, placeholder: "0.00", class: form_input_class %>
    <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Positive for income, negative for expenses</p>
  </div>

  <div>
    <%= f.label :account_id, "Account", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
    <%= f.collection_select :account_id, Account.active.order(:name), :id, :name,
                            { prompt: "Select an account" },
                            class: form_input_class %>
  </div>

  <div>
    <%= f.label :memo, class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
    <%= f.text_area :memo, rows: 3, class: form_input_class %>
  </div>

  <div>
    <%= f.label :file, "Attachment (optional)", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
    <%= f.file_field :file, class: form_file_input_class %>
  </div>

  <div class="flex gap-2">
    <%= f.submit class: "rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700 cursor-pointer" %>
    <%= link_to "Cancel", accounting_transactions_path, class: form_cancel_link_class %>
  </div>
<% end %>
