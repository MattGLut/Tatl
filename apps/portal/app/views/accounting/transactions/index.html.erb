<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold">Transactions</h1>
  <% if policy([:accounting, Transaction.new]).create? %>
    <%= link_to "New Transaction", new_accounting_transaction_path, class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700" %>
  <% end %>
</div>

<div class="mt-4 rounded-lg border border-slate-200 bg-white px-4 py-4">
  <%= form_tag accounting_transactions_path, method: :get do %>
    <%= hidden_field_tag :sort, params[:sort] if params[:sort].present? %>
    <%= hidden_field_tag :dir, params[:dir] if params[:dir].present? %>
    <div class="grid grid-cols-2 gap-x-3 gap-y-3 sm:grid-cols-4">
      <div>
        <label for="txn_account_id" class="mb-1 block text-xs font-medium text-slate-500">Account</label>
        <%= select_tag :account_id, options_from_collection_for_select(@filter_accounts, :id, :name, params[:account_id]), include_blank: "All", id: "txn_account_id", class: "block h-9 w-full rounded-md border border-slate-300 bg-white px-2.5 text-sm text-slate-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" %>
      </div>
      <div>
        <label for="txn_transacted_on_start" class="mb-1 block text-xs font-medium text-slate-500">Date from</label>
        <%= date_field_tag :transacted_on_start, params[:transacted_on_start], id: "txn_transacted_on_start", class: "block h-9 w-full rounded-md border border-slate-300 bg-white px-2.5 text-sm text-slate-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" %>
      </div>
      <div>
        <label for="txn_transacted_on_end" class="mb-1 block text-xs font-medium text-slate-500">Date to</label>
        <%= date_field_tag :transacted_on_end, params[:transacted_on_end], id: "txn_transacted_on_end", class: "block h-9 w-full rounded-md border border-slate-300 bg-white px-2.5 text-sm text-slate-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" %>
      </div>
      <div>
        <span class="mb-1 block text-xs">&nbsp;</span>
        <div class="flex gap-2">
          <%= submit_tag "Apply", class: "inline-flex h-9 cursor-pointer items-center rounded-md bg-indigo-600 px-4 text-sm font-medium text-white shadow-sm hover:bg-indigo-700" %>
          <%= link_to "Clear", accounting_transactions_path, class: "inline-flex h-9 items-center rounded-md border border-slate-300 px-3 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50" %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<div class="mt-6 overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
  <table class="min-w-full divide-y divide-slate-200">
    <thead class="bg-slate-50">
      <tr>
        <%= sortable_th "transacted_on", "Date", default_dir: :desc %>
        <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-500">Account</th>
        <%= sortable_th "memo", "Memo" %>
        <%= sortable_th "amount_cents", "Amount", default_dir: :desc, th_class: "px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-slate-500" %>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-200">
      <% @transactions.each do |txn| %>
        <tr>
          <td class="whitespace-nowrap px-4 py-3 text-sm text-slate-600"><%= txn.transacted_on.strftime("%b %d, %Y") %></td>
          <td class="px-4 py-3 text-sm text-slate-600"><%= txn.account.name %></td>
          <td class="px-4 py-3 text-sm text-slate-900"><%= txn.memo %></td>
          <td class="whitespace-nowrap px-4 py-3 text-right text-sm font-medium <%= txn.amount_cents.negative? ? "text-rose-600" : "text-emerald-600" %>">
            <%= humanized_money_with_symbol(txn.amount) %>
          </td>
          <td class="px-4 py-3 text-right text-sm">
            <%= link_to "View", accounting_transaction_path(txn), class: "text-indigo-600 hover:text-indigo-800" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= render "shared/pagination", pagy: @pagy %>
</div>
