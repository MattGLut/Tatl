<h1 class="text-2xl font-bold">Dues Aging Report</h1>

<div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-4">
  <% @aging_buckets.each do |bucket, entries| %>
    <div class="rounded-lg border p-4 <%= aging_bucket_class(bucket) %>">
      <p class="text-sm font-medium text-slate-700"><%= aging_bucket_label(bucket) %></p>
      <p class="mt-1 text-2xl font-bold"><%= entries.size %></p>
      <p class="text-sm text-slate-500"><%= humanized_money_with_symbol(Money.new(entries.sum { |e| e[:balance].cents }, "USD")) %> outstanding</p>
    </div>
  <% end %>
</div>

<% @aging_buckets.each do |bucket, entries| %>
  <% next if entries.empty? %>

  <div class="mt-8">
    <h2 class="text-lg font-semibold"><%= aging_bucket_label(bucket) %></h2>
    <div class="mt-3 overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
      <table class="min-w-full divide-y divide-slate-200">
        <thead class="bg-slate-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-500">Property</th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-500">Due Date</th>
            <th class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-slate-500">Assessed</th>
            <th class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-slate-500">Balance</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200">
          <% entries.each do |entry| %>
            <tr>
              <td class="px-4 py-3 text-sm text-slate-900"><%= entry[:assessment].property.name %></td>
              <td class="px-4 py-3 text-sm text-slate-600"><%= entry[:assessment].due_date.strftime("%b %d, %Y") %></td>
              <td class="whitespace-nowrap px-4 py-3 text-right text-sm text-slate-600"><%= humanized_money_with_symbol(entry[:assessment].amount) %></td>
              <td class="whitespace-nowrap px-4 py-3 text-right text-sm font-medium text-rose-600"><%= humanized_money_with_symbol(entry[:balance]) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
