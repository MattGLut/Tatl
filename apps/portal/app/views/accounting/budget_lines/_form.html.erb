<%= form_with(model: [:accounting, budget_line], class: "space-y-6") do |f| %>
  <% if budget_line.errors.any? %>
    <div class="rounded-md border border-rose-200 dark:border-rose-800 bg-rose-50 dark:bg-rose-900/30 p-4 text-sm text-rose-800 dark:text-rose-300">
      <ul class="list-inside list-disc">
        <% budget_line.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :account_id, "Account", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
    <%= f.collection_select :account_id, Account.active.order(:name), :id, :name,
                            { prompt: "Select an account" },
                            class: form_input_class %>
  </div>

  <div>
    <%= f.label :fiscal_year, class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
    <%= f.number_field :fiscal_year, value: budget_line.fiscal_year || Date.current.year, class: form_input_class %>
  </div>

  <div>
    <%= f.label :amount, class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
    <%= f.text_field :amount, value: budget_line.amount.to_f.nonzero?, placeholder: "0.00", class: form_input_class %>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
    <%= f.text_field :description, class: form_input_class %>
  </div>

  <div class="flex gap-2">
    <%= f.submit class: "rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700 cursor-pointer" %>
    <%= link_to "Cancel", accounting_budget_lines_path, class: form_cancel_link_class %>
  </div>
<% end %>
