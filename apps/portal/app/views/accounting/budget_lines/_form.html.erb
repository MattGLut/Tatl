<%= form_with(model: [:accounting, budget_line], class: "space-y-6") do |f| %>
  <% if budget_line.errors.any? %>
    <div class="rounded-md border border-rose-200 bg-rose-50 p-4 text-sm text-rose-800">
      <ul class="list-inside list-disc">
        <% budget_line.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :account_id, "Account", class: "block text-sm font-medium text-slate-700" %>
    <%= f.collection_select :account_id, Account.active.order(:name), :id, :name, { prompt: "Select an account" }, class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
  </div>

  <div>
    <%= f.label :fiscal_year, class: "block text-sm font-medium text-slate-700" %>
    <%= f.number_field :fiscal_year, value: budget_line.fiscal_year || Date.current.year, class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
  </div>

  <div>
    <%= f.label :amount, class: "block text-sm font-medium text-slate-700" %>
    <%= f.text_field :amount, value: budget_line.amount.to_f.nonzero?, placeholder: "0.00", class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm font-medium text-slate-700" %>
    <%= f.text_field :description, class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
  </div>

  <div class="flex gap-2">
    <%= f.submit class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 cursor-pointer" %>
    <%= link_to "Cancel", accounting_budget_lines_path, class: "rounded-md border border-slate-300 px-4 py-2 text-sm hover:bg-slate-100" %>
  </div>
<% end %>
