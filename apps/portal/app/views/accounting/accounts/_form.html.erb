<%= form_with(model: [:accounting, account], class: "space-y-6") do |f| %>
  <% if account.errors.any? %>
    <div class="rounded-md border border-rose-200 dark:border-rose-800 bg-rose-50 dark:bg-rose-900/30 p-4 text-sm text-rose-800 dark:text-rose-300">
      <ul class="list-inside list-disc">
        <% account.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
    <%= f.text_field :name, class: form_input_class %>
  </div>

  <div>
    <%= f.label :account_type, class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
    <%= f.select :account_type, Account.account_types.keys.map { |t| [t.titleize, t] }, {},
                 class: form_input_class %>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
    <%= f.text_area :description, rows: 3, class: form_input_class %>
  </div>

  <div class="flex items-center gap-2">
    <%= f.check_box :active, class: "h-4 w-4 rounded border-slate-300 dark:border-slate-600 text-brand-600 focus:ring-brand-500" %>
    <%= f.label :active, "Active", class: "text-sm font-medium text-slate-700 dark:text-slate-300" %>
  </div>

  <div class="flex gap-2">
    <%= f.submit class: "rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700 cursor-pointer" %>
    <%= link_to "Cancel", accounting_accounts_path, class: form_cancel_link_class %>
  </div>
<% end %>
