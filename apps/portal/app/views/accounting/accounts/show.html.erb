<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold"><%= @account.name %></h1>
  <div class="flex gap-2">
    <% if policy([:accounting, @account]).update? %>
      <%= link_to "Edit", edit_accounting_account_path(@account), class: "rounded-md border border-slate-300 px-3 py-1.5 text-sm hover:bg-slate-100" %>
    <% end %>
    <%= link_to "Back", accounting_accounts_path, class: "rounded-md border border-slate-300 px-3 py-1.5 text-sm hover:bg-slate-100" %>
  </div>
</div>

<div class="mt-6 rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
  <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <dt class="text-sm font-medium text-slate-500">Type</dt>
      <dd class="mt-1 text-sm text-slate-900"><%= @account.account_type.titleize %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-slate-500">Status</dt>
      <dd class="mt-1 text-sm">
        <span class="inline-flex rounded-full px-2 py-0.5 text-xs font-medium <%= @account.active? ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-600' %>">
          <%= @account.active? ? "Active" : "Inactive" %>
        </span>
      </dd>
    </div>
    <% if @account.description.present? %>
      <div class="sm:col-span-2">
        <dt class="text-sm font-medium text-slate-500">Description</dt>
        <dd class="mt-1 text-sm text-slate-900"><%= @account.description %></dd>
      </div>
    <% end %>
  </dl>
</div>
