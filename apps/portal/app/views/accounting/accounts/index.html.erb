<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold">Chart of Accounts</h1>
  <% if policy([:accounting, Account.new]).create? %>
    <%= link_to "New Account", new_accounting_account_path, class: "rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700" %>
  <% end %>
</div>

<div class="mt-6 overflow-hidden rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 shadow-sm">
  <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-700">
    <thead class="bg-slate-50 dark:bg-slate-800/80">
      <tr>
        <%= sortable_th "name", "Name" %>
        <%= sortable_th "account_type", "Type" %>
        <%= sortable_th "active", "Status", default_dir: :desc %>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
      <% @accounts.each do |account| %>
        <tr>
          <td class="px-4 py-3 text-sm font-medium text-slate-900 dark:text-slate-100">
            <%= link_to account.name, accounting_account_path(account), class: "hover:text-brand-600 dark:hover:text-brand-400" %>
          </td>
          <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-400"><%= account.account_type.titleize %></td>
          <td class="px-4 py-3 text-sm">
            <span class="inline-flex rounded-full px-2 py-0.5 text-xs font-medium <%= account.active? ? "bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-400" : "bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-300" %>">
              <%= account.active? ? "Active" : "Inactive" %>
            </span>
          </td>
          <td class="px-4 py-3 text-right text-sm">
            <% if policy([:accounting, account]).update? %>
              <%= link_to "Edit", edit_accounting_account_path(account), class: "text-brand-600 hover:text-brand-800 dark:text-brand-400 dark:hover:text-brand-300" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
