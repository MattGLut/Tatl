<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold">Chart of Accounts</h1>
  <% if policy([:accounting, Account.new]).create? %>
    <%= link_to "New Account", new_accounting_account_path, class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700" %>
  <% end %>
</div>

<div class="mt-6 overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
  <table class="min-w-full divide-y divide-slate-200">
    <thead class="bg-slate-50">
      <tr>
        <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-500">Name</th>
        <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-500">Type</th>
        <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-500">Status</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-200">
      <% @accounts.each do |account| %>
        <tr>
          <td class="px-4 py-3 text-sm font-medium text-slate-900">
            <%= link_to account.name, accounting_account_path(account), class: "hover:text-indigo-600" %>
          </td>
          <td class="px-4 py-3 text-sm text-slate-600"><%= account.account_type.titleize %></td>
          <td class="px-4 py-3 text-sm">
            <span class="inline-flex rounded-full px-2 py-0.5 text-xs font-medium <%= account.active? ? "bg-emerald-100 text-emerald-800" : "bg-slate-100 text-slate-600" %>">
              <%= account.active? ? "Active" : "Inactive" %>
            </span>
          </td>
          <td class="px-4 py-3 text-right text-sm">
            <% if policy([:accounting, account]).update? %>
              <%= link_to "Edit", edit_accounting_account_path(account), class: "text-indigo-600 hover:text-indigo-800" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
