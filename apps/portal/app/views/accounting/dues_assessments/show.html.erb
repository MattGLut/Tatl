<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold">Dues Assessment</h1>
  <div class="flex gap-2">
    <% if policy([:accounting, @assessment]).update? %>
      <%= link_to "Edit", edit_accounting_dues_assessment_path(@assessment), class: "rounded-md border border-slate-300 dark:border-slate-600 px-3 py-1.5 text-sm hover:bg-slate-100 dark:hover:bg-slate-700" %>
    <% end %>
    <%= link_to "Back", accounting_dues_assessments_path, class: "rounded-md border border-slate-300 dark:border-slate-600 px-3 py-1.5 text-sm hover:bg-slate-100 dark:hover:bg-slate-700" %>
  </div>
</div>

<div class="mt-6 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-6 shadow-sm">
  <dl class="grid grid-cols-1 gap-4 sm:grid-cols-3">
    <div>
      <dt class="text-sm font-medium text-slate-500 dark:text-slate-400">Property</dt>
      <dd class="mt-1 text-sm text-slate-900 dark:text-slate-100"><%= @assessment.property.name %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-slate-500 dark:text-slate-400">Amount</dt>
      <dd class="mt-1 text-sm font-medium text-slate-900 dark:text-slate-100"><%= humanized_money_with_symbol(@assessment.amount) %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-slate-500 dark:text-slate-400">Status</dt>
      <dd class="mt-1">
        <span class="inline-flex rounded-full px-2 py-0.5 text-xs font-medium <%= assessment_status_class(@assessment.status) %>">
          <%= @assessment.status.titleize %>
        </span>
      </dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-slate-500 dark:text-slate-400">Period</dt>
      <dd class="mt-1 text-sm text-slate-900 dark:text-slate-100"><%= @assessment.period_start.strftime("%b %d, %Y") %> - <%= @assessment.period_end.strftime("%b %d, %Y") %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-slate-500 dark:text-slate-400">Due Date</dt>
      <dd class="mt-1 text-sm text-slate-900 dark:text-slate-100"><%= @assessment.due_date.strftime("%b %d, %Y") %></dd>
    </div>
    <% if @assessment.description.present? %>
      <div>
        <dt class="text-sm font-medium text-slate-500 dark:text-slate-400">Description</dt>
        <dd class="mt-1 text-sm text-slate-900 dark:text-slate-100"><%= @assessment.description %></dd>
      </div>
    <% end %>
  </dl>
</div>

<div class="mt-8">
  <div class="flex items-center justify-between">
    <h2 class="text-lg font-semibold">Payments</h2>
    <% if policy([:accounting, DuesPayment.new]).create? && !@assessment.paid? %>
      <%= link_to "Record Payment", new_accounting_dues_assessment_payment_path(@assessment), class: "rounded-md bg-emerald-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-emerald-700" %>
    <% end %>
  </div>

  <% if @payments.any? %>
    <div class="mt-4 overflow-hidden rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 shadow-sm">
      <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-700">
        <thead class="bg-slate-50 dark:bg-slate-800/80">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-500 dark:text-slate-400">Date</th>
            <th class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-slate-500 dark:text-slate-400">Amount</th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-500 dark:text-slate-400">Reference</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
          <% @payments.each do |payment| %>
            <tr>
              <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-400"><%= payment.paid_on.strftime("%b %d, %Y") %></td>
              <td class="whitespace-nowrap px-4 py-3 text-right text-sm font-medium text-emerald-600"><%= humanized_money_with_symbol(payment.amount) %></td>
              <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-400"><%= payment.reference %></td>
              <td class="px-4 py-3 text-right text-sm">
                <% if policy([:accounting, payment]).destroy? %>
                  <%= button_to "Remove", accounting_dues_assessment_payment_path(@assessment, payment), method: :delete, class: "cursor-pointer text-rose-600 hover:text-rose-800 dark:text-rose-400 dark:hover:text-rose-300", data: { turbo_confirm: "Are you sure?" } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="mt-4 text-sm text-slate-500 dark:text-slate-400">No payments recorded yet.</p>
  <% end %>
</div>
