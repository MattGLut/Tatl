<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold">Dues Assessments</h1>
  <% if policy([:accounting, DuesAssessment.new]).create? %>
    <%= link_to "New Assessment", new_accounting_dues_assessment_path, class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700" %>
  <% end %>
</div>

<div class="mt-6 overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
  <table class="min-w-full divide-y divide-slate-200">
    <thead class="bg-slate-50">
      <tr>
        <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-500">Property</th>
        <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-500">Period</th>
        <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-500">Due Date</th>
        <th class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-slate-500">Amount</th>
        <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-500">Status</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-200">
      <% @assessments.each do |assessment| %>
        <tr>
          <td class="px-4 py-3 text-sm text-slate-900"><%= assessment.property.name %></td>
          <td class="px-4 py-3 text-sm text-slate-600"><%= assessment.period_start.strftime("%b %Y") %> - <%= assessment.period_end.strftime("%b %Y") %></td>
          <td class="px-4 py-3 text-sm text-slate-600"><%= assessment.due_date.strftime("%b %d, %Y") %></td>
          <td class="whitespace-nowrap px-4 py-3 text-right text-sm font-medium text-slate-900"><%= humanized_money_with_symbol(assessment.amount) %></td>
          <td class="px-4 py-3 text-sm">
            <% status_colors = { "open" => "bg-blue-100 text-blue-800", "partial" => "bg-amber-100 text-amber-800", "paid" => "bg-emerald-100 text-emerald-800", "overdue" => "bg-rose-100 text-rose-800" } %>
            <span class="inline-flex rounded-full px-2 py-0.5 text-xs font-medium <%= status_colors[assessment.status] %>">
              <%= assessment.status.titleize %>
            </span>
          </td>
          <td class="px-4 py-3 text-right text-sm">
            <%= link_to "View", accounting_dues_assessment_path(assessment), class: "text-indigo-600 hover:text-indigo-800" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
