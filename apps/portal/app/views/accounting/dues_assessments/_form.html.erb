<%= form_with(model: [:accounting, assessment], class: "space-y-6") do |f| %>
  <% if assessment.errors.any? %>
    <div class="rounded-md border border-rose-200 dark:border-rose-800 bg-rose-50 dark:bg-rose-900/30 p-4 text-sm text-rose-800 dark:text-rose-300">
      <ul class="list-inside list-disc">
        <% assessment.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :property_id, "Property", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
    <%= f.collection_select :property_id, Property.order(:name), :id, :name, { prompt: "Select a property" },
                            class: form_input_class %>
  </div>

  <div>
    <%= f.label :amount, class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
    <%= f.text_field :amount, value: assessment.amount.to_f.nonzero?, placeholder: "0.00", class: form_input_class %>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :period_start, class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
      <%= f.date_field :period_start, class: form_input_class %>
    </div>
    <div>
      <%= f.label :period_end, class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
      <%= f.date_field :period_end, class: form_input_class %>
    </div>
  </div>

  <div>
    <%= f.label :due_date, class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
    <%= f.date_field :due_date, class: form_input_class %>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
    <%= f.text_field :description, class: form_input_class %>
  </div>

  <div class="flex gap-2">
    <%= f.submit class: "rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700 cursor-pointer" %>
    <%= link_to "Cancel", accounting_dues_assessments_path, class: form_cancel_link_class %>
  </div>
<% end %>
