<% content_for :title, "#{@document.title} - NeIQhbor" %>

<div class="flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-bold tracking-tight text-slate-900"><%= @document.title %></h1>
    <div class="mt-1 flex items-center gap-2">
      <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-600"><%= @document.category.humanize %></span>
      <% if @document.published? %>
        <span class="rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-medium text-emerald-700">Published <%= @document.published_at.strftime("%b %d, %Y") %></span>
      <% else %>
        <span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-700">Draft</span>
      <% end %>
    </div>
  </div>
  <div class="flex gap-2">
    <% if policy(@document).destroy? %>
      <%= button_to "Delete", document_path(@document), method: :delete, class: "rounded-md border border-rose-300 px-3 py-1.5 text-sm text-rose-600 hover:bg-rose-50", data: { turbo_confirm: "Are you sure you want to delete this document?" } %>
    <% end %>
    <%= link_to "Back", documents_path, class: "rounded-md border border-slate-300 px-3 py-1.5 text-sm hover:bg-slate-100" %>
  </div>
</div>

<section class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
  <% if @document.description.present? %>
    <div class="text-sm text-slate-700"><%= simple_format(@document.description) %></div>
    <hr class="my-4 border-slate-200">
  <% end %>

  <dl class="grid gap-4 sm:grid-cols-2 text-sm">
    <div>
      <dt class="text-xs font-medium text-slate-500">Uploaded by</dt>
      <dd class="mt-1 text-slate-900"><%= @document.uploaded_by.display_name %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium text-slate-500">Uploaded on</dt>
      <dd class="mt-1 text-slate-900"><%= @document.created_at.strftime("%B %d, %Y at %l:%M %p") %></dd>
    </div>
  </dl>

  <% if @document.file.attached? %>
    <div class="mt-6">
      <%= link_to rails_blob_path(@document.file, disposition: "attachment"), class: "inline-flex items-center gap-2 rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700" do %>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        Download <%= @document.file.filename %>
      <% end %>
      <p class="mt-1 text-xs text-slate-400"><%= number_to_human_size(@document.file.byte_size) %></p>
    </div>
  <% end %>
</section>
