<% content_for :title, "Upload document - NeIQhbor" %>

<h1 class="text-2xl font-bold tracking-tight text-slate-900">Upload document</h1>

<div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
  <%= form_with(model: @document, class: "space-y-6") do |f| %>
    <% if @document.errors.any? %>
      <div class="rounded-md border border-rose-200 bg-rose-50 p-4">
        <h3 class="text-sm font-medium text-rose-800"><%= pluralize(@document.errors.count, "error") %> prevented this document from being saved:</h3>
        <ul class="mt-2 list-inside list-disc text-sm text-rose-700">
          <% @document.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid gap-6 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <%= f.label :title, class: "block text-sm font-medium text-slate-700" %>
        <%= f.text_field :title, class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      </div>

      <div>
        <%= f.label :category, class: "block text-sm font-medium text-slate-700" %>
        <%= f.select :category, Document.categories.keys.map { |c| [c.humanize, c] }, {}, class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      </div>

      <div>
        <%= f.label :published_at, "Publish date (leave blank for draft)", class: "block text-sm font-medium text-slate-700" %>
        <%= f.datetime_local_field :published_at, class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      </div>

      <div class="sm:col-span-2">
        <%= f.label :description, class: "block text-sm font-medium text-slate-700" %>
        <%= f.text_area :description, rows: 3, class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      </div>

      <div class="sm:col-span-2">
        <%= f.label :file, class: "block text-sm font-medium text-slate-700" %>
        <%= f.file_field :file, class: "mt-1 block w-full text-sm text-slate-500 file:mr-4 file:rounded-md file:border-0 file:bg-indigo-50 file:px-4 file:py-2 file:text-sm file:font-medium file:text-indigo-700 hover:file:bg-indigo-100" %>
      </div>
    </div>

    <div class="flex justify-end gap-3">
      <%= link_to "Cancel", documents_path, class: "rounded-md border border-slate-300 px-4 py-2 text-sm hover:bg-slate-100" %>
      <%= f.submit "Upload", class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 cursor-pointer" %>
    </div>
  <% end %>
</div>
